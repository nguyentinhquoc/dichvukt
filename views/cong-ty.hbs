<div class="container py-5">
    <div class="mx-auto" style="max-width:1000px;">

        <h4 class="fw-bold mb-4">Quản lý công ty</h4>

        <datalist id="label-suggestions">
            <option value="Địa chỉ">
            <option value="Đại diện bởi">
            <option value="Chức vụ">
            <option value="Mã số thuế">
            <option value="Số điện thoại">
            <option value="Tài khoản số">
        </datalist>

        <!-- Thêm công ty mới -->
        <div class="card shadow mb-4 border-start border-4 border-primary">
            <div class="card-body">
                <h5 class="fw-bold mb-3 text-primary">➕ Thêm công ty mới</h5>
                <form action="/cong-ty" method="POST" class="d-flex gap-2">
                    <input type="text" name="title" class="form-control" placeholder="Tên công ty" required>
                    <button type="submit" class="btn btn-primary text-nowrap">Thêm công ty</button>
                </form>
            </div>
        </div>

        <!-- Tìm kiếm công ty -->
        <div class="mb-4">
            <input type="text" id="companySearchInput" class="form-control" placeholder="🔍 Tìm theo tên công ty...">
        </div>

        <!-- Danh sách công ty -->
        <div id="companyList">
        {{#each companies}}
        <div class="card shadow mb-4 company-card" data-title="{{title}}">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <form action="/cong-ty/{{id}}/rename" method="POST" class="d-flex gap-2 flex-grow-1 me-3">
                        <input type="text" name="title" class="form-control fw-bold" value="{{title}}" required>
                        <button type="submit" class="btn btn-outline-primary text-nowrap">Lưu tên</button>
                    </form>
                    <form action="/cong-ty/{{id}}/delete" method="POST" onsubmit="return confirm('Xóa công ty này và toàn bộ thông tin liên quan?');">
                        <button type="submit" class="btn btn-outline-danger">Xóa công ty</button>
                    </form>
                </div>

                <table class="table table-bordered align-middle">
                    <thead>
                        <tr>
                            <th style="width:90px">STT</th>
                            <th style="width:25%">Nhãn (label)</th>
                            <th>Giá trị (value)</th>
                            <th style="width:160px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each infos}}
                        <tr>
                            <td><input type="number" name="order" form="info-update-{{id}}" class="form-control" value="{{order}}"></td>
                            <td><input type="text" name="label" form="info-update-{{id}}" class="form-control" value="{{label}}" list="label-suggestions" required></td>
                            <td><input type="text" name="value" form="info-update-{{id}}" class="form-control" value="{{value}}"></td>
                            <td class="d-flex gap-2">
                                <button type="submit" form="info-update-{{id}}" class="btn btn-sm btn-outline-primary">Lưu</button>
                                <button type="submit" form="info-delete-{{id}}" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </td>
                        </tr>
                        {{/each}}
                        <tr>
                            <td><input type="number" name="order" form="info-add-{{id}}" class="form-control" value="0"></td>
                            <td><input type="text" name="label" form="info-add-{{id}}" class="form-control" placeholder="VD: Địa chỉ, Chức vụ, Mã số thuế, Tài khoản số..." list="label-suggestions" required></td>
                            <td><input type="text" name="value" form="info-add-{{id}}" class="form-control" placeholder="Giá trị"></td>
                            <td><button type="submit" form="info-add-{{id}}" class="btn btn-sm btn-primary">Thêm dòng</button></td>
                        </tr>
                    </tbody>
                </table>
                <p class="text-muted small">Số thứ tự (STT) nhỏ hơn sẽ xếp trước, cả trong bảng này lẫn trong file Word xuất ra.</p>

                <!-- Form ẩn: các input trong bảng tham chiếu tới đây qua thuộc tính form="" -->
                {{#each infos}}
                <form id="info-update-{{id}}" action="/cong-ty/info/{{id}}/update" method="POST"></form>
                <form id="info-delete-{{id}}" action="/cong-ty/info/{{id}}/delete" method="POST" onsubmit="return confirm('Xóa dòng này?');"></form>
                {{/each}}
                <form id="info-add-{{id}}" action="/cong-ty/{{id}}/info" method="POST"></form>

                <p class="text-muted small mb-0">
                    Khi tạo hợp đồng mua bán, mỗi dòng ở đây sẽ in ra 1 dòng "Nhãn: Giá trị" trong phần Bên bán (chỉ riêng dòng "Tên công ty" là cố định).
                    Sắp xếp theo STT tăng dần.
                </p>

            </div>
        </div>
        {{else}}
        <p class="text-muted">Chưa có công ty nào. Thêm công ty đầu tiên ở trên.</p>
        {{/each}}
        </div>
        <p class="text-muted" id="companySearchEmpty" style="display:none;">Không tìm thấy công ty nào phù hợp.</p>

    </div>
</div>

<script>
    (function () {
        var searchInput = document.getElementById('companySearchInput');
        if (!searchInput) return;
        var cards = Array.prototype.slice.call(document.querySelectorAll('.company-card'));
        var emptyMsg = document.getElementById('companySearchEmpty');

        function normalizeVN(str) {
            return (str || '')
                .toLowerCase()
                .normalize('NFD').replace(/[̀-ͯ]/g, '')
                .replace(/đ/g, 'd');
        }

        searchInput.addEventListener('input', function () {
            var keyword = normalizeVN(searchInput.value.trim());
            var visibleCount = 0;
            cards.forEach(function (card) {
                var match = normalizeVN(card.dataset.title).indexOf(keyword) !== -1;
                card.style.display = match ? '' : 'none';
                if (match) visibleCount++;
            });
            emptyMsg.style.display = (keyword && visibleCount === 0) ? '' : 'none';
        });
    })();
</script>
